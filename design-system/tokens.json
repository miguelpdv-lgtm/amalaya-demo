  "shadow": {
    "relieve": {
      "$type": "shadow",
      "$value": {
        "color": "{color.pigmento.sepia}",
        "offsetX": "4px",
        "offsetY": "4px",
        "blur": "0px",
        "spread": "0px"
      },
      "$description": "Letrero en reposo: sombra sólida desplazada"
    },
    "huella": {
      "$type": "shadow",
      "$value": {
        "color": "{color.pigmento.sepia}",
        "offsetX": "2px",
        "offsetY": "2px",
        "blur": "0px",
        "spread": "0px"
      },
      "$description": "Letrero hundido (hover)"
    },
    "veladura": {
      "$type": "shadow",
      "$value": [
        {
          "color": "#3B2A1D0F",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "0px",
          "spread": "0px"
        },
        {
          "color": "#3B2A1D47",
          "offsetX": "0px",
          "offsetY": "12px",
          "blur": "28px",
          "spread": "-12px"
        }
      ]
    }
  },
